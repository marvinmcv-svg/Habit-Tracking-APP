# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app (safe, non-secret keys only).
# Nothing here is required to run the app today — it is fully local-first.

# Supabase (Phase 1: accounts + sync). Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog analytics (src/lib/analytics.ts sink).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry crash reporting.
EXPO_PUBLIC_SENTRY_DSN=

# RevenueCat (Phase 3). Public SDK keys per platform.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Server-only secrets go in EAS secrets / Supabase secrets, never here:
#   SUPABASE_SERVICE_ROLE_KEY, REVENUECAT_WEBHOOK_SECRET, SENTRY_AUTH_TOKEN
